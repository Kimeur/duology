#!/usr/bin/env python3
"""duo-fold-cost launcher. The tool lives in duo_fold_cost.py next to this file.

Run `duo-fold-cost --help`, or `python3 duo_fold_cost.py --help` where this file can't be executed.
"""
import os
import runpy
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.argv[0] = "duo-fold-cost"
runpy.run_path(os.path.join(here, "duo_fold_cost.py"), run_name="__main__")
