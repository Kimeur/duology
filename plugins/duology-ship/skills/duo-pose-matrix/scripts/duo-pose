#!/usr/bin/env python3
"""duo-pose launcher. The tool lives in duo_pose.py next to this file.

Run `duo-pose --help`, or `python3 duo_pose.py --help` where this file can't be executed.
"""
import os
import runpy
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.argv[0] = "duo-pose"
runpy.run_path(os.path.join(here, "duo_pose.py"), run_name="__main__")
