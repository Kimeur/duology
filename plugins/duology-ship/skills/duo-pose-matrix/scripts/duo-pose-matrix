#!/usr/bin/env python3
"""duo-pose-matrix launcher. The tool lives in duo_pose_matrix.py next to this file.

Run `duo-pose-matrix --help`, or `python3 duo_pose_matrix.py --help` where this file can't be executed.
"""
import os
import runpy
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
sys.argv[0] = "duo-pose-matrix"
runpy.run_path(os.path.join(here, "duo_pose_matrix.py"), run_name="__main__")
